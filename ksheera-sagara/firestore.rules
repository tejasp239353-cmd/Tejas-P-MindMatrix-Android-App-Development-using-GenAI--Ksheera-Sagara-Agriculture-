rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Cow Rules ---
    match /cows/{cowId} {
      function isValidCow(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
               data.userId == request.auth.uid &&
               (data.tagNumber == null || (data.tagNumber is string && data.tagNumber.size() <= 50)) &&
               (data.breed == null || (data.breed is string && data.breed.size() <= 100));
      }

      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidCow(incoming()) && isValidId(cowId);
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidCow(incoming()) &&
                    incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    // --- MilkSlip Rules ---
    match /milkSlips/{slipId} {
      function isValidMilkSlip(data) {
        return data.userId == request.auth.uid &&
               data.liters is number && data.liters > 0 &&
               data.amount is number && data.amount >= 0 &&
               data.date is timestamp;
      }

      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidMilkSlip(incoming()) && isValidId(slipId);
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidMilkSlip(incoming()) &&
                    incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    // --- Expense Rules ---
    match /expenses/{expenseId} {
      function isValidExpense(data) {
        return data.userId == request.auth.uid &&
               data.amount is number && data.amount >= 0 &&
               data.category in ['Fodder', 'Medical', 'Labor', 'Electricity', 'Other'] &&
               data.date is timestamp;
      }

      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidExpense(incoming()) && isValidId(expenseId);
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidExpense(incoming()) &&
                    incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }
  }
}
